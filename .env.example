# --- Core (required) ---
DATABASE_URL=            # Neon serverless Postgres connection string
ANTHROPIC_API_KEY=       # Claude API key (or use per-user BYOK)
BYOK_ENCRYPTION_KEY=     # key used to encrypt user-supplied API keys at rest

# --- AWS S3 (file storage) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# --- LINE (bot + LIFF) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# --- App / cron ---
NEXT_PUBLIC_APP_URL=http://localhost:8000
CRON_SECRET=             # protects /api/cron/* endpoints
ADMIN_TOKEN=             # manual cron trigger / admin routes

# --- Search & extras (optional) ---
VOYAGE_API_KEY=          # embeddings for semantic search
EMBED_MODEL=
OPENAI_API_KEY=          # transcription
SUPADATA_API_KEY=        # YouTube transcript fetch
